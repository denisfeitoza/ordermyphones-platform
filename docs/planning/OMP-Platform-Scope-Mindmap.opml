<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>OMP Platform — Full Build Scope &amp; Estimate Map</title>
  </head>
  <body>
    <outline text="OMP Platform — Full Build Scope &amp; Estimate Map">
      <outline text="0 · How to read this map">
        <outline text="Status tags: [DONE] built &amp; working · [SCAFFOLD] structure exists, logic pending · [TODO] build from scratch · [NEW] new scope, designed not built"/>
        <outline text="Size hint = relative complexity, NOT hours: (S) small · (M) medium · (L) large · (XL) extra-large"/>
        <outline text="Current reality: frontend is a complete working MOCKUP on mock data (deployed to Vercel); backend is scaffold; all data wiring + new scope is to build"/>
        <outline text="Use per-leaf status + size to attach your hours/price for the OMP quote"/>
      </outline>
      <outline text="1 · Product &amp; Business Model">
        <outline text="Two commercial directions">
          <outline text="Storefront — sell to humans (tier-priced catalog, cart, checkout) [DONE mockup]"/>
          <outline text="Partner Inventory API — sell to machines (outbound feed + fulfillment) [NEW]"/>
        </outline>
        <outline text="Customer tiers (Pricing v2)">
          <outline text="T1 Consumer 1–9 · market-benchmark price"/>
          <outline text="T2 Retailer 10–49 · consumer − $20"/>
          <outline text="T3 Wholesale 50–399 · cost-plus band"/>
          <outline text="T4 Distributor 400+ · cost-plus band"/>
          <outline text="NOTE: docs adopt v2 names; live app still shows Multi-Store/Wholesale — rename pending"/>
        </outline>
        <outline text="Suppliers (inbound sources, masked from partners)">
          <outline text="Source 1 — Assurant / HYLA (US dropship, reverse-logistics volume)"/>
          <outline text="Source 2 — Mannapov LLC (US wholesale) + reserved Dubai (DXB) feed slot"/>
          <outline text="Masking: each supplier warehouse → OMP location e.g. TX1 → 'Texas Inventory'"/>
        </outline>
        <outline text="Actors &amp; roles">
          <outline text="Anonymous · Consumer · Retailer · Wholesale · Distributor"/>
          <outline text="Feed partner (read) · Fulfillment partner (write, e.g. SmartPay)"/>
          <outline text="Staff · Admin · Service (service_role) · AI agents (propose-only)"/>
        </outline>
        <outline text="Revenue mechanics">
          <outline text="Tier pricing margin (benchmark − cost)"/>
          <outline text="Partner cost-plus margin (margin_bps) for wholesale resellers"/>
          <outline text="SmartPay fulfillment (consumer price + to-be-defined OMP↔SP margin)"/>
        </outline>
      </outline>
