# Supabase — client-side config. Both values are PUBLIC (they ship in the browser bundle).
# Get them from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key ONLY. The secret server-side key must NEVER go here or in any VITE_ var.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Observability (ALL OPTIONAL — deferred config) --------------------------
# Leave these UNSET and the app runs exactly as today: Sentry and PostHog are
# no-ops until a key is present. Add them when going to production. See
# docs/architecture/OBSERVABILITY.md and docs/planning/AUTONOMOUS-DECISIONS.md.
#
# Sentry error tracking (PII-scrubbed client-side before send). Public DSN.
# VITE_SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>
#
# PostHog product analytics (identified by profile UUID only, never email).
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
#
# Environment label for Sentry + the TEST badge. Any value other than
# "production" makes the discreet TEST badge visible. Defaults to Vite's MODE.
# VITE_ENV=production
