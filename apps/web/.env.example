# Supabase — client-side config. Both values are PUBLIC (they ship in the browser bundle).
# Get them from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key ONLY. The secret server-side key must NEVER go here or in any VITE_ var.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
